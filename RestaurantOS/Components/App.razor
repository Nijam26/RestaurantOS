@using RestaurantOS.Services.Settings
@inject ISettingsService SettingsService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@_settings.RestaurantName · Restaurant OS</title>
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet />
    <style>
        :root {
            --brand-primary: @_settings.PrimaryColor;
            --brand-secondary: @_settings.SecondaryColor;
            --brand-accent: @_settings.AccentColor;
            --brand-font: @_settings.FontFamily;
        }
    </style>
</head>
<body class="@(_settings.DarkMode ? "theme-dark" : "theme-light")">
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/app.js"></script>
</body>
</html>

@code {
    private RestaurantOS.Models.RestaurantSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
    }
}
